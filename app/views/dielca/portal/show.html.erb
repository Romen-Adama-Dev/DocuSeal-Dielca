<%= render 'shared/html_title', title: 'Firmas DIELCA' %>
<main class="max-w-lg mx-auto px-4 mt-12 mb-8">
  <div class="rounded-xl border border-base-300 bg-base-100 p-6 space-y-4">
    <h1 class="text-xl font-bold">Hola, <%= @business['name'].presence || @business['email'] %></h1>
    <p>Has iniciado sesión con el perfil <strong><%= @role_label %></strong>.</p>
    <p>No tienes documentos disponibles.</p>
    <%= button_to 'Cerrar sesión', dielca_portal_session_path, method: :delete, class: 'base-button' %>
  </div>
</main>
